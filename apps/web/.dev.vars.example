# Local secrets. Copy to `.env` (or `.dev.vars` — either name works; `pnpm dev`
# links one to the other so there is only ever one file to edit).
#
# None of this is read in production: push those with
#   pnpm --filter @et/web exec wrangler secret put <NAME>

# --- Database -------------------------------------------------------------
# Neon connection string, pooled endpoint. Use a dev branch locally — Neon
# branches are cheap and keep your data away from production.
DATABASE_URL=""

# --- Auth -----------------------------------------------------------------
# Signs session cookies. Changing it signs everyone out.
#   openssl rand -base64 32
BETTER_AUTH_SECRET=""
# The app's own origin, no trailing slash. Must match in production.
BETTER_AUTH_URL="http://localhost:3100"

# Optional: "Continue with Google". Both halves or neither — the sign-in page
# hides the button unless both are set. Create an OAuth client at
# console.cloud.google.com, with this redirect URI:
#   http://localhost:3100/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Platform admin -----------------------------------------------------
# Comma-separated emails of the platform super admins: they get the admin
# console (/admin), create workspaces, and suspend, bill and limit them.
# Not a workspace role — admins only see inside workspaces they are members of.
# Also the only addresses that can sign up without an invite.
PLATFORM_ADMIN_EMAILS=""

# --- Email ----------------------------------------------------------------
# Resend is used when RESEND_API_KEY is set (a send-only key is enough), with
# EMAIL_FROM on a domain verified in Resend, e.g. hello@yourdomain.com.
RESEND_API_KEY=""
#
# Otherwise:
# Cloudflare Email Service. Password reset only actually sends once EMAIL_FROM
# is on a domain onboarded onto Email Sending:
#   pnpm --filter @et/web exec wrangler email sending enable yourdomain.com
# Leave it empty and reset mail is printed to the dev server log instead — the
# flow still works end to end, it just does not leave the machine.
EMAIL_FROM=""
EMAIL_REPLY_TO=""

# --- Telegram -------------------------------------------------------------
# The bot is the product's main interface. Create one with @BotFather.
TELEGRAM_BOT_TOKEN=""
# Username without the @, so invites render as one-tap t.me links.
TELEGRAM_BOT_USERNAME=""
# Echoed by Telegram on every update and checked by the webhook. Leave empty to
# reuse BETTER_AUTH_SECRET — the webhook URL is public, so this check is the
# only thing separating real updates from anyone who guesses the path.
TELEGRAM_WEBHOOK_SECRET=""

# --- Models ---------------------------------------------------------------
# Every model call goes through OpenRouter: one key, one bill, any vendor.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=""

# NOTE: OpenRouter serves no embedding models, so the Brand Brain's document
# search needs a separate provider. Not wired up yet.

# Optional: force every agent tier onto one catalog model — useful to pin
# everything to the free model while testing. Must be an id from
# packages/agents/src/models/catalog.ts.
# ET_DEFAULT_MODEL="qwen/qwen3.8-27b:free"

# Optional: the model that looks at photos sent to the bot. Must be a catalog
# model marked `seesImages`. Not affected by ET_DEFAULT_MODEL, since the text
# tiers cannot see. Defaults to google/gemini-2.5-flash-lite.
# ET_VISION_MODEL="openai/gpt-4o-mini"

# --- Marketing Studio media ------------------------------------------------
# Promo images and videos go through OpenRouter, on OPENROUTER_API_KEY above.
# Optional model overrides (defaults in packages/agents/src/media):
# OPENROUTER_IMAGE_MODEL="google/gemini-3.1-flash-image"
# OPENROUTER_VIDEO_MODEL="google/veo-3.1-fast"
# "Video + voice": the model that takes the ElevenLabs voiceover as its
# soundtrack, and the one provider known to accept it (falls back to Veo
# narrating the script if this path fails).
# OPENROUTER_VOICE_VIDEO_MODEL="alibaba/wan-2.7"
# OPENROUTER_VOICE_VIDEO_PROVIDER="atlas-cloud"
# Signing secret of the OpenRouter workspace webhook. With it (and an https
# BETTER_AUTH_URL), finished videos are reported to
# /api/marketing/openrouter-webhook; without it the 5-minute cron polls.
OPENROUTER_WEBHOOK_SECRET=""

# The voice in "Video + voice" comes from ElevenLabs (any paid plan; the key
# needs Text to Speech and Voices: Read). Optional — without it the video
# model narrates the script in its own voice.
# Create a key at https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=""
# The narrator when the requester picks none.
ELEVENLABS_DEFAULT_VOICE_ID=""
# ELEVENLABS_SPEECH_MODEL="eleven_multilingual_v2"

# Amharic voiceovers come from Azure Speech (ElevenLabs has no Amharic):
# voices Mekdes (female) and Ameha (male). Create a Speech resource in the
# Azure portal (the free F0 tier is 0.5M characters a month) and copy Key 1
# and its region, e.g. "eastus". Without them, Amharic is not offered.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
