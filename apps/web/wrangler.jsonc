{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Renaming the product means renaming this Worker too — see
  // packages/core/src/branding.ts.
  "name": "negarit-branding",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  // Our own entry, not Start's default: Start exports only `fetch`, and cron
  // triggers are delivered to `scheduled`. See src/worker.ts.
  "main": "src/worker.ts",
  // Monday 06:00 UTC is 09:00 in Addis — the plan lands before the week starts.
  "triggers": { "crons": ["0 6 * * 1"] },
  "observability": {
    "enabled": true
  },
  // Cloudflare Email Service. Sending only works once the EMAIL_FROM domain is
  // onboarded: `pnpm --filter @et/web exec wrangler email sending enable <domain>`.
  // Until then resolveEmailSender falls back to printing mail to the log.
  "send_email": [{ "name": "EMAIL" }],
  // Photos sent to the bot: the original and the polished copy, both private.
  // Create once per account:
  //   pnpm --filter @et/web exec wrangler r2 bucket create negarit
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "negarit" }],
  // Applies the light photo polish (exposure, contrast, sharpen, crop).
  // Remote even in dev: the local stand-in only resizes and silently ignores
  // brightness, contrast, gamma, saturation and sharpen — the whole point.
  // Needs `wrangler login` (or CLOUDFLARE_API_TOKEN) to run `pnpm dev`.
  // First 5,000 unique transformations a month are free.
  "images": { "binding": "IMAGES", "remote": true },
  // Secrets are NOT set here. Push them with:
  //   pnpm --filter @et/web exec wrangler secret put DATABASE_URL
  //   pnpm --filter @et/web exec wrangler secret put DEEPSEEK_API_KEY
  "vars": {}
}
